{
  // Shared Volante tasks. Run via: Terminal > Run Task…  (or ⌘/Ctrl+Shift+B for the default).
  // These wrap the same `uv` commands documented in the README — nothing VSCode-specific
  // is required to use Volante; this is just one-keystroke convenience inside the editor.
  //
  // "type": "process", not "shell". A shell task builds a command LINE, and VS Code
  // quotes an argument only when it contains a space, a quote or a backslash — so a
  // goal typed as `a;id` would reach the shell unquoted and the `;` would be read as a
  // command separator. A process task hands argv to the OS, where the goal stays one
  // element whatever characters it holds.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Volante: Run goal",
      "detail": "Prompt for a goal and orchestrate it end-to-end (plan → workers → synthesis).",
      "type": "process",
      "command": "uv",
      "args": ["run", "volante", "${input:volanteGoal}"],
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Volante: Run goal (JSON output)",
      "detail": "Same as above but emit a machine-readable JSON RunResult.",
      "type": "process",
      "command": "uv",
      "args": ["run", "volante", "--json", "${input:volanteGoal}"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Volante: Web UI",
      "detail": "Serve the live streaming Web UI at http://127.0.0.1:8000 (Ctrl+C to stop).",
      "type": "process",
      "command": "uv",
      "args": ["run", "--extra", "ui", "python", "-m", "webui"],
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Volante: MCP server (stdio)",
      "detail": "Run the Model Context Protocol server so an IDE AI agent can call volante_run.",
      "type": "process",
      "command": "uv",
      "args": ["run", "--extra", "mcp", "python", "-m", "volante_mcp"],
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Volante: Test",
      "detail": "Run the test suite (no network; integration tests skipped by default).",
      "type": "process",
      "command": "uv",
      "args": ["run", "pytest", "-q"],
      "problemMatcher": [],
      "group": { "kind": "test", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Volante: Lint",
      "detail": "Ruff lint the whole project.",
      "type": "process",
      "command": "uv",
      "args": ["run", "ruff", "check", "."],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    }
  ],
  "inputs": [
    {
      "id": "volanteGoal",
      "type": "promptString",
      "description": "Goal for Volante to orchestrate",
      "default": "Write a short brief about concurrency in Python"
    }
  ]
}
