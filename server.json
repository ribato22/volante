{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.ribato22/volante",
  "title": "Volante",
  "description": "Routes to the best predicted fit from configured metadata/evidence after hard-capability filtering.",
  "repository": {
    "url": "https://github.com/ribato22/volante",
    "source": "github"
  },
  "version": "0.5.0",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "volante",
      "version": "0.5.0",
      "runtimeHint": "uvx",
      "runtimeArguments": [
        { "type": "named", "name": "--from", "value": "volante[mcp]==0.5.0" },
        { "type": "positional", "value": "volante-mcp" }
      ],
      "transport": { "type": "stdio" },
      "environmentVariables": [
        { "name": "ANTHROPIC_API_KEY", "description": "Anthropic API key.", "isRequired": false, "isSecret": true },
        { "name": "ANTHROPIC_MODELS", "description": "Comma-separated Anthropic wire model ids.", "isRequired": false, "isSecret": false },
        { "name": "ANTHROPIC_NAMES", "description": "Optional comma-separated canonical model ids.", "isRequired": false, "isSecret": false },
        { "name": "ANTHROPIC_STRENGTHS", "description": "Shared comma-separated routing strengths.", "isRequired": false, "isSecret": false },
        { "name": "ANTHROPIC_CONTEXT", "description": "Shared context-window tokens.", "isRequired": false, "isSecret": false },
        { "name": "ANTHROPIC_MAX_OUTPUT", "description": "Shared maximum output tokens.", "isRequired": false, "isSecret": false },
        { "name": "ANTHROPIC_TOOLS", "description": "Declare tool-call support (1 or 0).", "isRequired": false, "isSecret": false },
        { "name": "ANTHROPIC_COST_IN", "description": "Shared USD per 1k input tokens.", "isRequired": false, "isSecret": false },
        { "name": "ANTHROPIC_COST_OUT", "description": "Shared USD per 1k output tokens.", "isRequired": false, "isSecret": false },
        { "name": "ANTHROPIC_TIER", "description": "Shared capability tier from 1 to 4.", "isRequired": false, "isSecret": false },

        { "name": "MOONSHOT_API_KEY", "description": "Moonshot API key.", "isRequired": false, "isSecret": true },
        { "name": "MOONSHOT_BASE_URL", "description": "Moonshot OpenAI-compatible base URL.", "isRequired": false, "isSecret": false },
        { "name": "MOONSHOT_MODELS", "description": "Comma-separated Moonshot wire model ids.", "isRequired": false, "isSecret": false },
        { "name": "MOONSHOT_NAMES", "description": "Optional comma-separated canonical model ids.", "isRequired": false, "isSecret": false },
        { "name": "MOONSHOT_STRENGTHS", "description": "Shared comma-separated routing strengths.", "isRequired": false, "isSecret": false },
        { "name": "MOONSHOT_CONTEXT", "description": "Shared context-window tokens.", "isRequired": false, "isSecret": false },
        { "name": "MOONSHOT_MAX_OUTPUT", "description": "Shared maximum output tokens.", "isRequired": false, "isSecret": false },
        { "name": "MOONSHOT_TOOLS", "description": "Declare tool-call support (1 or 0).", "isRequired": false, "isSecret": false },
        { "name": "MOONSHOT_COST_IN", "description": "Shared USD per 1k input tokens.", "isRequired": false, "isSecret": false },
        { "name": "MOONSHOT_COST_OUT", "description": "Shared USD per 1k output tokens.", "isRequired": false, "isSecret": false },
        { "name": "MOONSHOT_TIER", "description": "Shared capability tier from 1 to 4.", "isRequired": false, "isSecret": false },

        { "name": "OLLAMA_BASE_URL", "description": "Local Ollama OpenAI-compatible base URL.", "isRequired": false, "isSecret": false },
        { "name": "OLLAMA_API_KEY", "description": "Optional credential for the Ollama endpoint.", "isRequired": false, "isSecret": true },
        { "name": "OLLAMA_MODELS", "description": "Comma-separated Ollama wire model ids.", "isRequired": false, "isSecret": false },
        { "name": "OLLAMA_NAMES", "description": "Optional comma-separated canonical model ids.", "isRequired": false, "isSecret": false },
        { "name": "OLLAMA_STRENGTHS", "description": "Shared comma-separated routing strengths.", "isRequired": false, "isSecret": false },
        { "name": "OLLAMA_CONTEXT", "description": "Shared context-window tokens.", "isRequired": false, "isSecret": false },
        { "name": "OLLAMA_MAX_OUTPUT", "description": "Shared maximum output tokens.", "isRequired": false, "isSecret": false },
        { "name": "OLLAMA_TOOLS", "description": "Declare tool-call support (1 or 0).", "isRequired": false, "isSecret": false },
        { "name": "OLLAMA_COST_IN", "description": "Shared USD per 1k input tokens.", "isRequired": false, "isSecret": false },
        { "name": "OLLAMA_COST_OUT", "description": "Shared USD per 1k output tokens.", "isRequired": false, "isSecret": false },
        { "name": "OLLAMA_TIER", "description": "Shared capability tier from 1 to 4.", "isRequired": false, "isSecret": false },

        { "name": "CLAUDE_CODE_ENABLED", "description": "Set to 1 to enable the logged-in Claude Code CLI.", "isRequired": false, "isSecret": false },
        { "name": "CLAUDE_CODE_MODELS", "description": "Comma-separated Claude Code model ids.", "isRequired": false, "isSecret": false },
        { "name": "CLAUDE_CODE_TIER", "description": "Shared capability tier from 1 to 4.", "isRequired": false, "isSecret": false },
        { "name": "CLAUDE_CODE_MAX_OUTPUT", "description": "Shared maximum output tokens.", "isRequired": false, "isSecret": false },
        { "name": "CLAUDE_CODE_TIMEOUT", "description": "Per-call timeout in seconds.", "isRequired": false, "isSecret": false },
        { "name": "CLAUDE_CODE_SYSTEM_PROMPT_MODE", "description": "System-prompt mode: replace or append.", "isRequired": false, "isSecret": false },

        { "name": "CODEX_ENABLED", "description": "Set to 1 to enable the logged-in Codex CLI.", "isRequired": false, "isSecret": false },
        { "name": "CODEX_MODELS", "description": "Comma-separated Codex model ids.", "isRequired": false, "isSecret": false },
        { "name": "CODEX_TIER", "description": "Required capability tier from 1 to 4 when enabled.", "isRequired": false, "isSecret": false },
        { "name": "CODEX_CONTEXT", "description": "Shared context-window tokens.", "isRequired": false, "isSecret": false },
        { "name": "CODEX_MAX_OUTPUT", "description": "Shared maximum output tokens.", "isRequired": false, "isSecret": false },
        { "name": "CODEX_COST_IN", "description": "Shared API-equivalent input valuation.", "isRequired": false, "isSecret": false },
        { "name": "CODEX_COST_OUT", "description": "Shared API-equivalent output valuation.", "isRequired": false, "isSecret": false },
        { "name": "CODEX_TIMEOUT", "description": "Per-call timeout in seconds.", "isRequired": false, "isSecret": false },

        { "name": "OPENAI_COMPAT_BASE_URL", "description": "Compatible slot 1 base URL.", "isRequired": false, "isSecret": false },
        { "name": "OPENAI_COMPAT_KEY", "description": "Compatible slot 1 API key.", "isRequired": false, "isSecret": true },
        { "name": "OPENAI_COMPAT_MODEL", "description": "Compatible slot 1 wire model id.", "isRequired": false, "isSecret": false },
        { "name": "OPENAI_COMPAT_NAME", "description": "Compatible slot 1 canonical model id.", "isRequired": false, "isSecret": false },
        { "name": "OPENAI_COMPAT_STRENGTHS", "description": "Compatible slot 1 comma-separated strengths.", "isRequired": false, "isSecret": false },
        { "name": "OPENAI_COMPAT_CONTEXT", "description": "Compatible slot 1 context-window tokens.", "isRequired": false, "isSecret": false },
        { "name": "OPENAI_COMPAT_MAX_OUTPUT", "description": "Compatible slot 1 maximum output tokens.", "isRequired": false, "isSecret": false },
        { "name": "OPENAI_COMPAT_TOOLS", "description": "Compatible slot 1 tool-call support (1 or 0).", "isRequired": false, "isSecret": false },
        { "name": "OPENAI_COMPAT_COST_IN", "description": "Compatible slot 1 input cost.", "isRequired": false, "isSecret": false },
        { "name": "OPENAI_COMPAT_COST_OUT", "description": "Compatible slot 1 output cost.", "isRequired": false, "isSecret": false },
        { "name": "OPENAI_COMPAT_TIER", "description": "Compatible slot 1 capability tier.", "isRequired": false, "isSecret": false },

        { "name": "OPENAI_COMPAT_2_BASE_URL", "description": "Compatible slot 2 base URL.", "isRequired": false, "isSecret": false },
        { "name": "OPENAI_COMPAT_2_KEY", "description": "Compatible slot 2 API key.", "isRequired": false, "isSecret": true },
        { "name": "OPENAI_COMPAT_2_MODEL", "description": "Compatible slot 2 wire model id.", "isRequired": false, "isSecret": false },
        { "name": "OPENAI_COMPAT_2_NAME", "description": "Compatible slot 2 canonical model id.", "isRequired": false, "isSecret": false },
        { "name": "OPENAI_COMPAT_2_STRENGTHS", "description": "Compatible slot 2 comma-separated strengths.", "isRequired": false, "isSecret": false },
        { "name": "OPENAI_COMPAT_2_CONTEXT", "description": "Compatible slot 2 context-window tokens.", "isRequired": false, "isSecret": false },
        { "name": "OPENAI_COMPAT_2_MAX_OUTPUT", "description": "Compatible slot 2 maximum output tokens.", "isRequired": false, "isSecret": false },
        { "name": "OPENAI_COMPAT_2_TOOLS", "description": "Compatible slot 2 tool-call support (1 or 0).", "isRequired": false, "isSecret": false },
        { "name": "OPENAI_COMPAT_2_COST_IN", "description": "Compatible slot 2 input cost.", "isRequired": false, "isSecret": false },
        { "name": "OPENAI_COMPAT_2_COST_OUT", "description": "Compatible slot 2 output cost.", "isRequired": false, "isSecret": false },
        { "name": "OPENAI_COMPAT_2_TIER", "description": "Compatible slot 2 capability tier.", "isRequired": false, "isSecret": false },

        { "name": "OPENAI_COMPAT_3_BASE_URL", "description": "Compatible slot 3 base URL.", "isRequired": false, "isSecret": false },
        { "name": "OPENAI_COMPAT_3_KEY", "description": "Compatible slot 3 API key.", "isRequired": false, "isSecret": true },
        { "name": "OPENAI_COMPAT_3_MODEL", "description": "Compatible slot 3 wire model id.", "isRequired": false, "isSecret": false },
        { "name": "OPENAI_COMPAT_3_NAME", "description": "Compatible slot 3 canonical model id.", "isRequired": false, "isSecret": false },
        { "name": "OPENAI_COMPAT_3_STRENGTHS", "description": "Compatible slot 3 comma-separated strengths.", "isRequired": false, "isSecret": false },
        { "name": "OPENAI_COMPAT_3_CONTEXT", "description": "Compatible slot 3 context-window tokens.", "isRequired": false, "isSecret": false },
        { "name": "OPENAI_COMPAT_3_MAX_OUTPUT", "description": "Compatible slot 3 maximum output tokens.", "isRequired": false, "isSecret": false },
        { "name": "OPENAI_COMPAT_3_TOOLS", "description": "Compatible slot 3 tool-call support (1 or 0).", "isRequired": false, "isSecret": false },
        { "name": "OPENAI_COMPAT_3_COST_IN", "description": "Compatible slot 3 input cost.", "isRequired": false, "isSecret": false },
        { "name": "OPENAI_COMPAT_3_COST_OUT", "description": "Compatible slot 3 output cost.", "isRequired": false, "isSecret": false },
        { "name": "OPENAI_COMPAT_3_TIER", "description": "Compatible slot 3 capability tier.", "isRequired": false, "isSecret": false },

        { "name": "VOLANTE_QUALITY_PROFILES_FILE", "description": "Local strict-JSON quality-evidence file.", "isRequired": false, "isSecret": false },
        { "name": "VOLANTE_MODEL_OVERRIDES_FILE", "description": "Local strict-JSON per-model metadata override file.", "isRequired": false, "isSecret": false },
        { "name": "VOLANTE_FETCH_ALLOWLIST", "description": "Comma-separated domains that enable fetch_url.", "isRequired": false, "isSecret": false },
        { "name": "VOLANTE_READ_ROOT", "description": "Root directory that enables confined read_file.", "isRequired": false, "isSecret": false },
        { "name": "VOLANTE_SANDBOX", "description": "Agentic execution sandbox. Unset auto-selects docker when available and otherwise disables code execution; subprocess opts in to unisolated execution.", "isRequired": false, "isSecret": false },
        { "name": "VOLANTE_MAX_SUBSCRIPTION_CALLS", "description": "Physical subscription calls allowed per run.", "isRequired": false, "isSecret": false }
      ]
    }
  ]
}
