{
  "manifest_version": "0.2",
  "name": "volante",
  "display_name": "Volante",
  "version": "0.4.0",
  "description": "User-owned model routing and orchestration: plan a task DAG, then route each task to the best predicted fit from configured metadata/evidence after hard-capability filtering.",
  "author": { "name": "ribato22", "url": "https://github.com/ribato22/volante" },
  "homepage": "https://github.com/ribato22/volante",
  "documentation": "https://github.com/ribato22/volante#readme",
  "repository": { "type": "git", "url": "https://github.com/ribato22/volante" },
  "license": "MIT",
  "keywords": ["mcp", "ai-orchestration", "llm", "llm-router", "model-routing"],
  "server": {
    "type": "binary",
    "entry_point": "",
    "mcp_config": {
      "command": "uvx",
      "args": ["--from", "volante[mcp]==0.4.0", "volante-mcp"],
      "env": {
        "ANTHROPIC_API_KEY": "${user_config.anthropic_api_key}",
        "ANTHROPIC_MODELS": "${user_config.anthropic_models}",
        "ANTHROPIC_NAMES": "${user_config.anthropic_names}",
        "ANTHROPIC_STRENGTHS": "${user_config.anthropic_strengths}",
        "ANTHROPIC_CONTEXT": "${user_config.anthropic_context}",
        "ANTHROPIC_MAX_OUTPUT": "${user_config.anthropic_max_output}",
        "ANTHROPIC_TOOLS": "${user_config.anthropic_tools}",
        "ANTHROPIC_COST_IN": "${user_config.anthropic_cost_in}",
        "ANTHROPIC_COST_OUT": "${user_config.anthropic_cost_out}",
        "ANTHROPIC_TIER": "${user_config.anthropic_tier}",

        "MOONSHOT_API_KEY": "${user_config.moonshot_api_key}",
        "MOONSHOT_BASE_URL": "${user_config.moonshot_base_url}",
        "MOONSHOT_MODELS": "${user_config.moonshot_models}",
        "MOONSHOT_NAMES": "${user_config.moonshot_names}",
        "MOONSHOT_STRENGTHS": "${user_config.moonshot_strengths}",
        "MOONSHOT_CONTEXT": "${user_config.moonshot_context}",
        "MOONSHOT_MAX_OUTPUT": "${user_config.moonshot_max_output}",
        "MOONSHOT_TOOLS": "${user_config.moonshot_tools}",
        "MOONSHOT_COST_IN": "${user_config.moonshot_cost_in}",
        "MOONSHOT_COST_OUT": "${user_config.moonshot_cost_out}",
        "MOONSHOT_TIER": "${user_config.moonshot_tier}",

        "OLLAMA_BASE_URL": "${user_config.ollama_base_url}",
        "OLLAMA_API_KEY": "${user_config.ollama_api_key}",
        "OLLAMA_MODELS": "${user_config.ollama_models}",
        "OLLAMA_NAMES": "${user_config.ollama_names}",
        "OLLAMA_STRENGTHS": "${user_config.ollama_strengths}",
        "OLLAMA_CONTEXT": "${user_config.ollama_context}",
        "OLLAMA_MAX_OUTPUT": "${user_config.ollama_max_output}",
        "OLLAMA_TOOLS": "${user_config.ollama_tools}",
        "OLLAMA_COST_IN": "${user_config.ollama_cost_in}",
        "OLLAMA_COST_OUT": "${user_config.ollama_cost_out}",
        "OLLAMA_TIER": "${user_config.ollama_tier}",

        "CLAUDE_CODE_ENABLED": "${user_config.claude_code_enabled}",
        "CLAUDE_CODE_MODELS": "${user_config.claude_code_models}",
        "CLAUDE_CODE_TIER": "${user_config.claude_code_tier}",
        "CLAUDE_CODE_MAX_OUTPUT": "${user_config.claude_code_max_output}",
        "CLAUDE_CODE_TIMEOUT": "${user_config.claude_code_timeout}",
        "CLAUDE_CODE_SYSTEM_PROMPT_MODE": "${user_config.claude_code_system_prompt_mode}",

        "CODEX_ENABLED": "${user_config.codex_enabled}",
        "CODEX_MODELS": "${user_config.codex_models}",
        "CODEX_TIER": "${user_config.codex_tier}",
        "CODEX_CONTEXT": "${user_config.codex_context}",
        "CODEX_MAX_OUTPUT": "${user_config.codex_max_output}",
        "CODEX_COST_IN": "${user_config.codex_cost_in}",
        "CODEX_COST_OUT": "${user_config.codex_cost_out}",
        "CODEX_TIMEOUT": "${user_config.codex_timeout}",

        "OPENAI_COMPAT_BASE_URL": "${user_config.openai_compat_base_url}",
        "OPENAI_COMPAT_KEY": "${user_config.openai_compat_key}",
        "OPENAI_COMPAT_MODEL": "${user_config.openai_compat_model}",
        "OPENAI_COMPAT_NAME": "${user_config.openai_compat_name}",
        "OPENAI_COMPAT_STRENGTHS": "${user_config.openai_compat_strengths}",
        "OPENAI_COMPAT_CONTEXT": "${user_config.openai_compat_context}",
        "OPENAI_COMPAT_MAX_OUTPUT": "${user_config.openai_compat_max_output}",
        "OPENAI_COMPAT_TOOLS": "${user_config.openai_compat_tools}",
        "OPENAI_COMPAT_COST_IN": "${user_config.openai_compat_cost_in}",
        "OPENAI_COMPAT_COST_OUT": "${user_config.openai_compat_cost_out}",
        "OPENAI_COMPAT_TIER": "${user_config.openai_compat_tier}",

        "OPENAI_COMPAT_2_BASE_URL": "${user_config.openai_compat_2_base_url}",
        "OPENAI_COMPAT_2_KEY": "${user_config.openai_compat_2_key}",
        "OPENAI_COMPAT_2_MODEL": "${user_config.openai_compat_2_model}",
        "OPENAI_COMPAT_2_NAME": "${user_config.openai_compat_2_name}",
        "OPENAI_COMPAT_2_STRENGTHS": "${user_config.openai_compat_2_strengths}",
        "OPENAI_COMPAT_2_CONTEXT": "${user_config.openai_compat_2_context}",
        "OPENAI_COMPAT_2_MAX_OUTPUT": "${user_config.openai_compat_2_max_output}",
        "OPENAI_COMPAT_2_TOOLS": "${user_config.openai_compat_2_tools}",
        "OPENAI_COMPAT_2_COST_IN": "${user_config.openai_compat_2_cost_in}",
        "OPENAI_COMPAT_2_COST_OUT": "${user_config.openai_compat_2_cost_out}",
        "OPENAI_COMPAT_2_TIER": "${user_config.openai_compat_2_tier}",

        "OPENAI_COMPAT_3_BASE_URL": "${user_config.openai_compat_3_base_url}",
        "OPENAI_COMPAT_3_KEY": "${user_config.openai_compat_3_key}",
        "OPENAI_COMPAT_3_MODEL": "${user_config.openai_compat_3_model}",
        "OPENAI_COMPAT_3_NAME": "${user_config.openai_compat_3_name}",
        "OPENAI_COMPAT_3_STRENGTHS": "${user_config.openai_compat_3_strengths}",
        "OPENAI_COMPAT_3_CONTEXT": "${user_config.openai_compat_3_context}",
        "OPENAI_COMPAT_3_MAX_OUTPUT": "${user_config.openai_compat_3_max_output}",
        "OPENAI_COMPAT_3_TOOLS": "${user_config.openai_compat_3_tools}",
        "OPENAI_COMPAT_3_COST_IN": "${user_config.openai_compat_3_cost_in}",
        "OPENAI_COMPAT_3_COST_OUT": "${user_config.openai_compat_3_cost_out}",
        "OPENAI_COMPAT_3_TIER": "${user_config.openai_compat_3_tier}",

        "VOLANTE_QUALITY_PROFILES_FILE": "${user_config.quality_profiles_file}",
        "VOLANTE_MODEL_OVERRIDES_FILE": "${user_config.model_overrides_file}",
        "VOLANTE_FETCH_ALLOWLIST": "${user_config.fetch_allowlist}",
        "VOLANTE_READ_ROOT": "${user_config.read_root}",
        "VOLANTE_SANDBOX": "${user_config.sandbox}",
        "VOLANTE_MAX_SUBSCRIPTION_CALLS": "${user_config.max_subscription_calls}"
      }
    }
  },
  "user_config": {
    "anthropic_api_key": { "type": "string", "title": "Anthropic API key", "description": "Card-billed Anthropic API key.", "sensitive": true, "required": false },
    "anthropic_models": { "type": "string", "title": "Anthropic models", "description": "Comma-separated wire model ids.", "default": "claude-opus-4-8", "required": false },
    "anthropic_names": { "type": "string", "title": "Anthropic canonical names", "description": "Optional comma-separated canonical ids, one per model.", "required": false },
    "anthropic_strengths": { "type": "string", "title": "Anthropic strengths", "description": "Shared comma-separated strengths for this family.", "required": false },
    "anthropic_context": { "type": "string", "title": "Anthropic context window", "description": "Shared context-window tokens.", "required": false },
    "anthropic_max_output": { "type": "string", "title": "Anthropic max output", "description": "Shared maximum output tokens.", "required": false },
    "anthropic_tools": { "type": "string", "title": "Anthropic tool support", "description": "1/0 capability declaration.", "required": false },
    "anthropic_cost_in": { "type": "string", "title": "Anthropic input cost", "description": "USD per 1k input tokens.", "required": false },
    "anthropic_cost_out": { "type": "string", "title": "Anthropic output cost", "description": "USD per 1k output tokens.", "required": false },
    "anthropic_tier": { "type": "string", "title": "Anthropic tier", "description": "Shared capability tier 1-4.", "required": false },

    "moonshot_api_key": { "type": "string", "title": "Moonshot API key", "description": "Moonshot/Kimi API key.", "sensitive": true, "required": false },
    "moonshot_base_url": { "type": "string", "title": "Moonshot base URL", "description": "Optional OpenAI-compatible Moonshot endpoint.", "default": "https://api.moonshot.ai/v1", "required": false },
    "moonshot_models": { "type": "string", "title": "Moonshot models", "description": "Comma-separated wire model ids. Leave blank to use the current default.", "required": false },
    "moonshot_names": { "type": "string", "title": "Moonshot canonical names", "description": "Optional comma-separated canonical ids.", "required": false },
    "moonshot_strengths": { "type": "string", "title": "Moonshot strengths", "description": "Shared comma-separated strengths.", "required": false },
    "moonshot_context": { "type": "string", "title": "Moonshot context window", "description": "Shared context-window tokens.", "required": false },
    "moonshot_max_output": { "type": "string", "title": "Moonshot max output", "description": "Shared maximum output tokens.", "required": false },
    "moonshot_tools": { "type": "string", "title": "Moonshot tool support", "description": "1/0 capability declaration.", "required": false },
    "moonshot_cost_in": { "type": "string", "title": "Moonshot input cost", "description": "USD per 1k input tokens.", "required": false },
    "moonshot_cost_out": { "type": "string", "title": "Moonshot output cost", "description": "USD per 1k output tokens.", "required": false },
    "moonshot_tier": { "type": "string", "title": "Moonshot tier", "description": "Shared capability tier 1-4.", "required": false },

    "ollama_base_url": { "type": "string", "title": "Ollama base URL", "description": "Local OpenAI-compatible Ollama endpoint.", "required": false },
    "ollama_api_key": { "type": "string", "title": "Ollama API key", "description": "Optional local endpoint credential.", "default": "ollama", "sensitive": true, "required": false },
    "ollama_models": { "type": "string", "title": "Ollama models", "description": "Comma-separated local wire model ids.", "default": "llama3.2", "required": false },
    "ollama_names": { "type": "string", "title": "Ollama canonical names", "description": "Optional comma-separated canonical ids.", "required": false },
    "ollama_strengths": { "type": "string", "title": "Ollama strengths", "description": "Shared comma-separated strengths.", "required": false },
    "ollama_context": { "type": "string", "title": "Ollama context window", "description": "Shared context-window tokens.", "required": false },
    "ollama_max_output": { "type": "string", "title": "Ollama max output", "description": "Shared maximum output tokens.", "required": false },
    "ollama_tools": { "type": "string", "title": "Ollama tool support", "description": "1/0 capability declaration.", "required": false },
    "ollama_cost_in": { "type": "string", "title": "Ollama input cost", "description": "USD per 1k input tokens.", "required": false },
    "ollama_cost_out": { "type": "string", "title": "Ollama output cost", "description": "USD per 1k output tokens.", "required": false },
    "ollama_tier": { "type": "string", "title": "Ollama tier", "description": "Shared capability tier 1-4.", "required": false },

    "claude_code_enabled": { "type": "string", "title": "Claude Code subscription", "description": "1 enables the logged-in Claude CLI; 0 disables it.", "default": "0", "required": false },
    "claude_code_models": { "type": "string", "title": "Claude Code models", "description": "Comma-separated subscription model ids.", "default": "opus", "required": false },
    "claude_code_tier": { "type": "string", "title": "Claude Code tier", "description": "Shared capability tier 1-4.", "required": false },
    "claude_code_max_output": { "type": "string", "title": "Claude Code max output", "description": "Shared maximum output tokens.", "required": false },
    "claude_code_timeout": { "type": "string", "title": "Claude Code timeout", "description": "Per-call timeout in seconds.", "required": false },
    "claude_code_system_prompt_mode": { "type": "string", "title": "Claude Code system-prompt mode", "description": "replace (recommended) or append.", "required": false },

    "codex_enabled": { "type": "string", "title": "Codex subscription", "description": "1 enables the logged-in Codex CLI; 0 disables it.", "default": "0", "required": false },
    "codex_models": { "type": "string", "title": "Codex models", "description": "Comma-separated subscription model ids.", "default": "gpt-5-codex", "required": false },
    "codex_tier": { "type": "string", "title": "Codex tier", "description": "Required capability tier 1-4 when enabled.", "default": "3", "required": false },
    "codex_context": { "type": "string", "title": "Codex context window", "description": "Shared context-window tokens.", "required": false },
    "codex_max_output": { "type": "string", "title": "Codex max output", "description": "Shared maximum output tokens.", "required": false },
    "codex_cost_in": { "type": "string", "title": "Codex input valuation", "description": "API-equivalent USD per 1k input tokens.", "required": false },
    "codex_cost_out": { "type": "string", "title": "Codex output valuation", "description": "API-equivalent USD per 1k output tokens.", "required": false },
    "codex_timeout": { "type": "string", "title": "Codex timeout", "description": "Per-call timeout in seconds.", "required": false },

    "openai_compat_base_url": { "type": "string", "title": "Compatible slot 1 base URL", "description": "OpenAI-compatible endpoint.", "required": false },
    "openai_compat_key": { "type": "string", "title": "Compatible slot 1 API key", "description": "Optional for keyless local endpoints.", "sensitive": true, "required": false },
    "openai_compat_model": { "type": "string", "title": "Compatible slot 1 model", "description": "Wire model id; required with the base URL.", "required": false },
    "openai_compat_name": { "type": "string", "title": "Compatible slot 1 canonical name", "description": "Optional canonical model id.", "required": false },
    "openai_compat_strengths": { "type": "string", "title": "Compatible slot 1 strengths", "description": "Comma-separated strengths.", "required": false },
    "openai_compat_context": { "type": "string", "title": "Compatible slot 1 context", "description": "Context-window tokens.", "required": false },
    "openai_compat_max_output": { "type": "string", "title": "Compatible slot 1 max output", "description": "Maximum output tokens.", "required": false },
    "openai_compat_tools": { "type": "string", "title": "Compatible slot 1 tools", "description": "1 only when the endpoint's model supports tool calls.", "required": false },
    "openai_compat_cost_in": { "type": "string", "title": "Compatible slot 1 input cost", "description": "USD per 1k input tokens.", "required": false },
    "openai_compat_cost_out": { "type": "string", "title": "Compatible slot 1 output cost", "description": "USD per 1k output tokens.", "required": false },
    "openai_compat_tier": { "type": "string", "title": "Compatible slot 1 tier", "description": "Capability tier 1-4.", "required": false },

    "openai_compat_2_base_url": { "type": "string", "title": "Compatible slot 2 base URL", "description": "Second OpenAI-compatible endpoint.", "required": false },
    "openai_compat_2_key": { "type": "string", "title": "Compatible slot 2 API key", "description": "Optional for keyless endpoints.", "sensitive": true, "required": false },
    "openai_compat_2_model": { "type": "string", "title": "Compatible slot 2 model", "description": "Wire model id; required with the base URL.", "required": false },
    "openai_compat_2_name": { "type": "string", "title": "Compatible slot 2 canonical name", "description": "Optional canonical model id.", "required": false },
    "openai_compat_2_strengths": { "type": "string", "title": "Compatible slot 2 strengths", "description": "Comma-separated strengths.", "required": false },
    "openai_compat_2_context": { "type": "string", "title": "Compatible slot 2 context", "description": "Context-window tokens.", "required": false },
    "openai_compat_2_max_output": { "type": "string", "title": "Compatible slot 2 max output", "description": "Maximum output tokens.", "required": false },
    "openai_compat_2_tools": { "type": "string", "title": "Compatible slot 2 tools", "description": "1 only when tool calls are supported.", "required": false },
    "openai_compat_2_cost_in": { "type": "string", "title": "Compatible slot 2 input cost", "description": "USD per 1k input tokens.", "required": false },
    "openai_compat_2_cost_out": { "type": "string", "title": "Compatible slot 2 output cost", "description": "USD per 1k output tokens.", "required": false },
    "openai_compat_2_tier": { "type": "string", "title": "Compatible slot 2 tier", "description": "Capability tier 1-4.", "required": false },

    "openai_compat_3_base_url": { "type": "string", "title": "Compatible slot 3 base URL", "description": "Third OpenAI-compatible endpoint.", "required": false },
    "openai_compat_3_key": { "type": "string", "title": "Compatible slot 3 API key", "description": "Optional for keyless endpoints.", "sensitive": true, "required": false },
    "openai_compat_3_model": { "type": "string", "title": "Compatible slot 3 model", "description": "Wire model id; required with the base URL.", "required": false },
    "openai_compat_3_name": { "type": "string", "title": "Compatible slot 3 canonical name", "description": "Optional canonical model id.", "required": false },
    "openai_compat_3_strengths": { "type": "string", "title": "Compatible slot 3 strengths", "description": "Comma-separated strengths.", "required": false },
    "openai_compat_3_context": { "type": "string", "title": "Compatible slot 3 context", "description": "Context-window tokens.", "required": false },
    "openai_compat_3_max_output": { "type": "string", "title": "Compatible slot 3 max output", "description": "Maximum output tokens.", "required": false },
    "openai_compat_3_tools": { "type": "string", "title": "Compatible slot 3 tools", "description": "1 only when tool calls are supported.", "required": false },
    "openai_compat_3_cost_in": { "type": "string", "title": "Compatible slot 3 input cost", "description": "USD per 1k input tokens.", "required": false },
    "openai_compat_3_cost_out": { "type": "string", "title": "Compatible slot 3 output cost", "description": "USD per 1k output tokens.", "required": false },
    "openai_compat_3_tier": { "type": "string", "title": "Compatible slot 3 tier", "description": "Capability tier 1-4.", "required": false },

    "quality_profiles_file": { "type": "file", "title": "Quality profiles JSON", "description": "Strict JSON quality evidence keyed by canonical model id.", "required": false },
    "model_overrides_file": { "type": "file", "title": "Model overrides JSON", "description": "Strict JSON hard-capability/economic overrides.", "required": false },
    "fetch_allowlist": { "type": "string", "title": "Fetch domain allowlist", "description": "Comma-separated domains that enable fetch_url.", "required": false },
    "read_root": { "type": "directory", "title": "Read-file root", "description": "Root directory that enables confined read_file.", "required": false },
    "sandbox": { "type": "string", "title": "Agentic sandbox", "description": "Leave empty to auto-select Docker when available and otherwise disable code execution. 'docker' forces container isolation; 'subprocess' opts in to running model-generated code with your files and network.", "required": false },
    "max_subscription_calls": { "type": "string", "title": "Subscription call cap", "description": "Maximum physical subscription-provider calls per run.", "default": "16", "required": false }
  }
}
